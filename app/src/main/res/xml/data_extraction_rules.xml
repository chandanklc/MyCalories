<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same data to the user's Google account and when moving to a new phone. Photos and exports are not kept. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
